# Postgres - preenchido automaticamente pela integração "Prisma Postgres"
# do marketplace da Vercel (Storage → Create Database → Prisma Postgres).
# Não precisa configurar manualmente em produção; localmente, copie o valor
# de POSTGRES_URL do painel da Vercel (Settings → Environment Variables).
POSTGRES_URL="postgresql://user:password@host:5432/postgres"

# Segredo usado para assinar o cookie de sessão (string aleatória longa).
# Login agora é por e-mail+senha (tabela User) — os usuários iniciais (Yuri
# como ADMIN, Isabelli como VENDEDOR) já vêm de uma migration com senha em
# hash bcrypt. Novos usuários e redefinição de senha: painel /admin.
SESSION_SECRET="troque-este-segredo-aleatorio"

# Protege o endpoint de cron contra chamadas externas não autorizadas.
# A Vercel envia este valor automaticamente no header Authorization quando
# CRON_SECRET está configurado nas env vars do projeto.
CRON_SECRET="troque-este-segredo-de-cron"

# Google Places API - usada no sourcing dos dois segmentos (B2B profissional
# e Automotivo premium). Tem cota mensal gratuita.
GOOGLE_PLACES_API_KEY=""

# Anthropic API - usada só no sourcing "Busca livre com IA" (opcional, tem
# custo real por uso: ~US$10/1000 buscas + tokens do modelo). Sem essa
# variável, o resto do sistema funciona normalmente; só esse card retorna
# erro explicando o que falta. Gere em console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=""

# Dias sem atualização para disparar lembrete automático de cadência.
CADENCIA_LEMBRETE_DIAS="3"

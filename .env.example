# Postgres (Supabase) - use a connection string com pgbouncer para runtime
# e uma DIRECT_URL sem pgbouncer para migrations.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Senha única de acesso ao sistema (single-user). Gere algo forte.
APP_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão (string aleatória longa).
SESSION_SECRET="troque-este-segredo-aleatorio"

# Protege o endpoint de cron contra chamadas externas não autorizadas.
# A Vercel envia este valor automaticamente no header Authorization quando
# CRON_SECRET está configurado nas env vars do projeto.
CRON_SECRET="troque-este-segredo-de-cron"

# Google Places API (segmento Automotivo premium) - opcional, só necessário
# para usar o sourcing automotivo. Tem cota mensal gratuita.
GOOGLE_PLACES_API_KEY=""

# Sourcing B2B (CNPJ) - endpoints públicos, sem chave na maioria dos provedores.
# Ver README para detalhes e limitações de cada etapa (descoberta/enriquecimento).
CNPJ_ENRICHMENT_BASE_URL="https://brasilapi.com.br/api/cnpj/v1"
CNPJ_DISCOVERY_BASE_URL="https://api.cnpja.com/office"
CNPJ_DISCOVERY_API_KEY=""

# Camada de IA de qualificação de leads (opcional). Se vazio, a qualificação
# roda com heurísticas locais (sem chamada de IA) e nunca bloqueia o sourcing.
ANTHROPIC_API_KEY=""

# Dias sem atualização para disparar lembrete automático de cadência.
CADENCIA_LEMBRETE_DIAS="3"
